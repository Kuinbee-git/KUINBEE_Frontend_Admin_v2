# Browser-facing API base. Use /api with the same-origin proxy for local development.
NEXT_PUBLIC_API_URL=/api

# Server-only upstream origin used by the Next.js /api rewrite.
ADMIN_API_PROXY_TARGET=http://localhost:8000

# Abort stalled JSON API calls so controls recover instead of spinning forever.
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Abort stalled direct-to-object-store uploads (10 minutes by default).
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=600000

# Public marketplace origin used by admin links. Required in production.
NEXT_PUBLIC_USER_APP_URL=http://localhost:5175

# Temporary bridge for a backend that predates /v1/admin/dashboard/summary.
NEXT_PUBLIC_ADMIN_DASHBOARD_COMPAT_MODE=false

NEXT_PUBLIC_APP_NAME=Kuinbee Marketplace Admin
